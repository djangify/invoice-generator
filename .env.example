# Invoice Generator settings. Copy this file to ".env" (same folder).
# For normal local use you can change nothing: a secret key is generated the first time
# the app runs and stored in data/secret_key.txt.

# Leave False. True shows detailed error pages and is for development only.
DEBUG=False

# Leave unset to use the automatically generated per-install key (recommended).
# SECRET_KEY=

# Addresses that may open the app. Leave as is for use on your own computer.
ALLOWED_HOSTS=localhost,127.0.0.1

# First login (created the first time the app runs).
# Leave DJANGO_SUPERUSER_PASSWORD empty and a random password is generated, shown
# on screen and saved to data/first_login.txt. Setting your own is allowed but not
# recommended.
DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=

# Timezone
# TZ=Europe/London

# Optional email (password-reset emails). Without these, emails print to the console.
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=
