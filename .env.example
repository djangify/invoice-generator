# Invoice Generator settings. Copy this file to ".env" (same folder).
# For normal local use you can change nothing: a secret key is generated the first time
# the app runs and stored in data/secret_key.txt.

# Leave False. True shows detailed error pages and is for development only.
DEBUG=False

# Leave unset to use the automatically generated per-install key (recommended).
# SECRET_KEY=

# Hosts that may reach the app. Add your domain if you put it online.
ALLOWED_HOSTS=localhost,127.0.0.1

# Set True only once the app is served over HTTPS (for example behind a reverse proxy).
# It turns on HTTPS redirects and secure-only cookies, which stop plain http working.
# USE_HTTPS=False

# Only needed if the defaults do not work (they follow ALLOWED_HOSTS).
# Include the protocol, comma separated.
# CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# First login (created the first time the app runs).
# Leave DJANGO_SUPERUSER_PASSWORD empty and a random password is generated, printed in
# the logs and saved to data/first_login.txt. Setting your own is allowed but not
# recommended.
DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=

# Timezone
# TZ=Europe/London

# Recurring Invoice Scheduler (optional, defaults shown)
# SCHEDULE_HOUR=6
# SCHEDULE_MINUTE=0

# Optional email (password-reset emails). Without these, emails print to the console.
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=
